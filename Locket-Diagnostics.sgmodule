#!name=Locket Schema Diagnostics v1.0
#!desc=Read-only key/type logging. Disable other Locket rewrites while inspecting.

[MITM]
hostname = %APPEND% firebaseremoteconfig.googleapis.com

[Script]
nien_locket_schema = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-[A-Za-z0-9_-]+\/namespaces\/[^/?#]+:fetch(?:\?[^#]*)?$, script-path=https://raw.githubusercontent.com/NienCongChua/lk-diamond/d5c03bd81404517ea5dfc746890d1a7f7a866283/scripts/locket-diagnostics.js, requires-body=true, max-size=1048576, timeout=10
