#!name=Locket Filter Probe v0.1
#!desc=Read-only native filter investigation. No Photobooth injection. Can coexist with Locket-Custom; avoid other scripts on api.locketcamera.com.

[MITM]
hostname = %APPEND% api.locketcamera.com

[Script]
locket_filter_probe_request = type=http-request, pattern=^https:\/\/api\.locketcamera\.com(?:\/|$), script-path=https://raw.githubusercontent.com/NienCongChua/lk-diamond/d5c03bd81404517ea5dfc746890d1a7f7a866283/scripts/locket-filter-probe.js, timeout=5
locket_filter_probe_response = type=http-response, pattern=^https:\/\/api\.locketcamera\.com(?:\/|$), script-path=https://raw.githubusercontent.com/NienCongChua/lk-diamond/d5c03bd81404517ea5dfc746890d1a7f7a866283/scripts/locket-filter-probe.js, requires-body=true, max-size=1048576, timeout=5
